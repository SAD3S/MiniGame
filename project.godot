; Fichier de configuration principal du projet Godot 4.
; ------------------------------------------------------
; C'est ici que sont définis : le nom du jeu, la scène principale,
; la résolution, l'orientation portrait, le mode "stretch" adaptatif,
; les touches clavier (flèches + ZQSD/WASD) et le moteur de rendu mobile.

config_version=5

[application]

config/name="MiniGame"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

; Singleton qui centralise les entrées (clavier + joystick tactile).
Entrees="*res://scripts/entrees.gd"

[display]

; Résolution de référence en portrait (720x1280).
window/size/viewport_width=720
window/size/viewport_height=1280
; Orientation portrait verrouillée sur Android (1 = portrait).
window/handheld/orientation=1
; Mode "stretch" : l'affichage s'adapte à toutes les tailles d'écran.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

; Actions de déplacement clavier (pour tester sur PC).
; On utilise des "physical_keycode" : la position physique des touches.
; Ainsi WASD (clavier QWERTY) correspond automatiquement à ZQSD (clavier AZERTY).
deplacer_gauche={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194319,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
deplacer_droite={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194321,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
deplacer_haut={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194320,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
