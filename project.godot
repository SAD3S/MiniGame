[input_devices]

; La souris simule le tactile : le joystick virtuel marche aussi sur PC.
pointing/emulate_touch_from_mouse=true

[rendering]

; Moteur de rendu "Mobile" : optimisé pour Android, 60 FPS.
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
